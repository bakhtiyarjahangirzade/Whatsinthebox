<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PDFtoImage</id>
    <version>5.4.0</version>
    <authors>David Sungaila</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>Icon_128.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/sungaila/PDFtoImage</projectUrl>
    <description>A .NET library to render PDF files into images.</description>
    <releaseNotes>- Improved support for linearized and problematic PDFs using PDFium’s Availability API.
- Added lazy page-size loading so inaccessible pages no longer block unrelated pages.
- Relaxed the 4 GiB stream limit on supported 64-bit Unix platforms.</releaseNotes>
    <tags>PDF Bitmap Image Convert Conversion C# PDFium SkiaSharp Skia PNG JPG JPEG WEBP Xamarin Android iOS MacCatalyst Catalyst MAUI wasm WebAssembly</tags>
    <repository type="git" url="https://github.com/sungaila/PDFtoImage.git" commit="5948628cb2cf7d070c7fd28b1b4496db39e3afcd" />
